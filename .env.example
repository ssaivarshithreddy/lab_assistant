# Root Environment Configuration for Docker & Frontend
VITE_API_URL=http://localhost:5000/api
VITE_GROQ_API_KEY=your_groq_api_key_here

# SMTP Email Transport Configuration (for sending real 2FA/OTP emails)
# For Gmail: Use host smtp.gmail.com, port 587, and a 16-character Google App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="LabSense Medical AI" <your_email@gmail.com>
# Or use service shortcut:
# SMTP_SERVICE=gmail

