{
  "name": "lab_assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run --prefix backend dev\" \"npm run --prefix frontend dev\"",
    "start": "npm run --prefix backend start",
    "build": "npm run --prefix frontend build",
    "build:dev": "npm run --prefix frontend build:dev",
    "test": "npm run --prefix frontend test && npm run --prefix backend test",
    "test:frontend": "npm run --prefix frontend test",
    "test:backend": "npm run --prefix backend test",
    "lint": "npm run --prefix frontend lint",
    "docker:up": "docker compose up -d postgres minio",
    "docker:down": "docker compose down",
    "docker:all": "docker compose up -d --build",
    "minio": "powershell ./start-minio.ps1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
